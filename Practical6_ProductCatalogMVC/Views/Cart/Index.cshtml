@model IEnumerable<ProductCatalogMVC.Models.Product>

@{
    ViewData["Title"] = "Shopping Cart";
    decimal total = Model.Sum(item => item.Price);
}

<div class="container mt-5 mb-5">
    <h2 class="mb-4"><i class="bi bi-cart3"></i> Your Shopping Cart</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <h4>Your cart is empty.</h4>
            <p>Looks like you haven't added anything to your cart yet.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">Start Shopping</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Product</th>
                                    <th scope="col">Price</th>
                                    <th scope="col" class="pe-4 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <img src="@item.ImageUrl" class="rounded me-3 object-fit-cover" width="60" height="60" alt="@item.Name" />
                                                <div>
                                                    <h6 class="mb-0">@item.Name</h6>
                                                    <small class="text-muted">@item.Category</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td><strong>$@item.Price.ToString("0.00")</strong></td>
                                        <td class="pe-4 text-end">
                                            <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Remove</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mt-4 mt-md-0">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h4 class="card-title border-bottom pb-3 mb-3">Order Summary</h4>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span>$@total.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping</span>
                            <span class="text-success">Free</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-4">
                            <strong>Total</strong>
                            <strong class="fs-4 text-primary">$@total.ToString("0.00")</strong>
                        </div>
                        <button class="btn btn-success w-100 py-2 fs-5"><i class="bi bi-credit-card"></i> Checkout Securely</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
