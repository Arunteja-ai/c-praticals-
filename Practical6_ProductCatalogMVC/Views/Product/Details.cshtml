@model ProductCatalogMVC.Models.Product

@{
    ViewData["Title"] = Model.Name + " - Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="row g-0">
                    <div class="col-md-5">
                        <img src="@Model.ImageUrl" class="img-fluid rounded-start h-100 object-fit-cover" alt="@Model.Name">
                    </div>
                    <div class="col-md-7">
                        <div class="card-body p-4">
                            <h2 class="card-title text-primary">@Model.Name</h2>
                            <span class="badge bg-secondary mb-3">@Model.Category</span>
                            
                            <h3 class="text-success mb-3">$@Model.Price.ToString("0.00")</h3>
                            
                            <h5 class="mt-4">Description</h5>
                            <p class="card-text text-muted">@Model.Description</p>
                            
                            <div class="mt-5 d-flex gap-2">
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-grow-1">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button type="submit" class="btn btn-success w-100"><i class="bi bi-cart-plus"></i> Add to Cart</button>
                                </form>
                                <a asp-action="Index" class="btn btn-outline-secondary">Back to Catalog</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
