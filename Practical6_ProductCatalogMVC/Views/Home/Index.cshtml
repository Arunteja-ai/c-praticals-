@{
    ViewData["Title"] = "TechStore - The Best Electronics";
}

<div class="jumbotron text-center bg-light p-5 rounded-3 mb-5 shadow-sm">
    <h1 class="display-3 fw-bold text-primary">Welcome to TechStore</h1>
    <p class="lead mt-3">Your one-stop destination for high-quality electronics, gadgets, and modern tech accessories.</p>
    <hr class="my-4">
    <p>Discover our exclusive catalog featuring the latest laptops, ergonomic chairs, 4K monitors, and more!</p>
    <a class="btn btn-primary btn-lg mt-3 px-5 py-3 shadow-sm" asp-controller="Product" asp-action="Index" role="button">
        <i class="bi bi-bag-fill"></i> Shop Now
    </a>
</div>

<div class="row text-center mt-5">
    <div class="col-md-4 mb-4">
        <div class="p-4 border rounded shadow-sm h-100 bg-white">
            <h3 class="text-success"><i class="bi bi-truck"></i> Fast Shipping</h3>
            <p class="text-muted">Get your gear delivered to your doorstep within 48 hours, anywhere in the country.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="p-4 border rounded shadow-sm h-100 bg-white">
            <h3 class="text-success"><i class="bi bi-shield-check"></i> Secure Checkout</h3>
            <p class="text-muted">Our platform uses industry-leading encryption to keep your privacy and payments secure.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="p-4 border rounded shadow-sm h-100 bg-white">
            <h3 class="text-success"><i class="bi bi-arrow-return-left"></i> 30-Day Returns</h3>
            <p class="text-muted">Not satisfied? Return any product within 30 days for a full, no-questions-asked refund.</p>
        </div>
    </div>
</div>
