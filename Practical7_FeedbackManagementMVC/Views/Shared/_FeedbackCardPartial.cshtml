@model Practical7_FeedbackManagementMVC.Models.Feedback

<div class="col-md-6 col-lg-4">
    <div class="feedback-card p-4 h-100 d-flex flex-column justify-content-between position-relative">
        <div>
            <!-- Header: Category Badge & Date -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                @{
                    string badgeClass = Model.Category switch
                    {
                        "Course Curriculum" => "bg-primary",
                        "Faculty & Teaching" => "bg-success",
                        "Lab & Infrastructure" => "bg-indigo text-white",
                        "Campus Facilities" => "bg-warning text-dark",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @badgeClass px-2 py-1 rounded-pill" style="font-size: 0.75rem;">
                    @Model.Category
                </span>
                <span class="text-muted small">
                    <i class="bi bi-clock me-1"></i>@Model.SubmittedAt.ToString("dd MMM, hh:mm tt")
                </span>
            </div>

            <!-- Star Rating Display -->
            <div class="mb-2 rating-stars fs-6">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Model.Rating)
                    {
                        <i class="bi bi-star-fill"></i>
                    }
                    else
                    {
                        <i class="bi bi-star text-muted opacity-25"></i>
                    }
                }
                <span class="ms-1 fw-bold text-dark small">(@Model.Rating / 5)</span>
            </div>

            <!-- User Comments -->
            <p class="text-secondary mb-3" style="font-size: 0.95rem; line-height: 1.5;">
                &ldquo;@Model.Comments&rdquo;
            </p>
        </div>

        <!-- Card Footer: User Info & Recommendation -->
        <div class="pt-3 border-top mt-2">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.95rem;">@Model.FullName</h6>
                    <small class="text-muted" style="font-size: 0.8rem;">@Model.Email</small>
                </div>
                <div>
                    @if (Model.WouldRecommend)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 py-1 px-2" title="Recommends this facility">
                            <i class="bi bi-check-circle-fill me-1"></i>Recommends
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 py-1 px-2">
                            <i class="bi bi-x-circle-fill me-1"></i>Not Recommending
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
