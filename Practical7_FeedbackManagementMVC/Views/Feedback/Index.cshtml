@model Practical7_FeedbackManagementMVC.Models.FeedbackDashboardViewModel

@{
    ViewData["Title"] = "Feedback Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-grid-1x2-fill text-primary me-2"></i>Campus Feedback Dashboard
        </h2>
        <p class="text-muted mb-0">Monitor student evaluations, course feedback, and academic facility ratings.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill"></i> Give New Feedback
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Partial View: Feedback Statistics Summary Cards -->
@await Html.PartialAsync("_FeedbackStatsPartial", Model)

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4 bg-white rounded-3">
    <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-funnel-fill text-primary"></i>
            <span class="fw-semibold text-dark">Filter by Category:</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(Model.SelectedCategory) ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
                All Categories
            </a>
            @foreach (var cat in Model.Categories)
            {
                <a asp-action="Index" asp-route-category="@cat"
                   class="btn btn-sm @(Model.SelectedCategory == cat ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
                    @cat
                </a>
            }
        </div>
    </div>
</div>

<!-- Feedback Cards Grid rendered using Partial View -->
<div class="row g-4">
    @if (Model.Feedbacks.Any())
    {
        @foreach (var item in Model.Feedbacks)
        {
            <!-- Demonstrating Partial View Rendering -->
            <partial name="_FeedbackCardPartial" model="item" />
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="p-5 bg-white rounded-4 shadow-sm border">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <h4 class="mt-3 text-secondary">No feedbacks found in this category.</h4>
                <p class="text-muted">Be the first to share your experience!</p>
                <a asp-action="Create" class="btn btn-primary-custom mt-2">Submit Feedback</a>
            </div>
        </div>
    }
</div>
